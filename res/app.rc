#include <winres.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_APP     ICON "app.ico"
IDI_GREEN   ICON "green.ico"
IDI_YELLOW  ICON "yellow.ico"
IDI_RED     ICON "red.ico"

IDD_SETTINGS DIALOGEX 0, 0, 440, 300
STYLE DS_SETFONT | DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "NDI2SDI Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Output 1", 1107, 7, 8, 426, 52
    AUTOCHECKBOX    "On", 1100, 14, 22, 26, 10
    LTEXT           "Name:", -1, 46, 23, 24, 8
    EDITTEXT        1101, 72, 21, 80, 12, ES_AUTOHSCROLL
    LTEXT           "Source:", -1, 160, 23, 28, 8
    COMBOBOX        1102, 190, 21, 52, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        1103, 246, 21, 180, 150, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        1104, 246, 21, 180, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "SDI out:", -1, 46, 41, 26, 8
    COMBOBOX        1105, 72, 39, 170, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Format:", -1, 246, 41, 28, 8
    COMBOBOX        1106, 276, 39, 150, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "Output 2", 1117, 7, 64, 426, 52
    AUTOCHECKBOX    "On", 1110, 14, 78, 26, 10
    LTEXT           "Name:", -1, 46, 79, 24, 8
    EDITTEXT        1111, 72, 77, 80, 12, ES_AUTOHSCROLL
    LTEXT           "Source:", -1, 160, 79, 28, 8
    COMBOBOX        1112, 190, 77, 52, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        1113, 246, 77, 180, 150, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        1114, 246, 77, 180, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "SDI out:", -1, 46, 97, 26, 8
    COMBOBOX        1115, 72, 95, 170, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Format:", -1, 246, 97, 28, 8
    COMBOBOX        1116, 276, 95, 150, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "Output 3", 1127, 7, 120, 426, 52
    AUTOCHECKBOX    "On", 1120, 14, 134, 26, 10
    LTEXT           "Name:", -1, 46, 135, 24, 8
    EDITTEXT        1121, 72, 133, 80, 12, ES_AUTOHSCROLL
    LTEXT           "Source:", -1, 160, 135, 28, 8
    COMBOBOX        1122, 190, 133, 52, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        1123, 246, 133, 180, 150, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        1124, 246, 133, 180, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "SDI out:", -1, 46, 153, 26, 8
    COMBOBOX        1125, 72, 151, 170, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Format:", -1, 246, 153, 28, 8
    COMBOBOX        1126, 276, 151, 150, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Refresh lists", IDC_REFRESH, 7, 178, 64, 14
    LTEXT           "Display = capture a Windows screen (lowest delay). NDI = network source; type its exact name if it is offline.", IDC_SOURCE_HINT, 78, 178, 355, 18
    LTEXT           "Output buffer:", -1, 7, 202, 60, 8
    COMBOBOX        IDC_BUFFER, 72, 200, 170, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Start output automatically when the app launches", IDC_AUTOSTART, 7, 220, 300, 10
    AUTOCHECKBOX    "Run at Windows startup", IDC_RUNATSTARTUP, 7, 234, 300, 10
    LTEXT           "Status:", -1, 7, 252, 30, 8
    LTEXT           "", IDC_STATUS, 40, 252, 393, 26, SS_NOPREFIX
    DEFPUSHBUTTON   "Save", IDOK, 327, 280, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 383, 280, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "NDI2SDI - NDI to DeckLink SDI output"
            VALUE "FileVersion", "1.1.0"
            VALUE "InternalName", "NDI2SDI"
            VALUE "OriginalFilename", "NDI2SDI.exe"
            VALUE "ProductName", "NDI2SDI"
            VALUE "ProductVersion", "1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
