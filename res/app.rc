#include <winres.h>
#include <commctrl.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_APP     ICON "app.ico"
IDI_GREEN   ICON "green.ico"
IDI_YELLOW  ICON "yellow.ico"
IDI_RED     ICON "red.ico"

IDD_SETTINGS DIALOGEX 0, 0, 440, 378
STYLE DS_SETFONT | DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "Screen2SDI Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    // Output rows are created at run time inside this scrolling panel (SettingsDialog.cpp).
    CONTROL         "", IDC_ROWS, "Screen2SDI.Rows", WS_CHILD | WS_VISIBLE | WS_VSCROLL, 7, 7, 426, 200, WS_EX_CONTROLPARENT | WS_EX_STATICEDGE
    PUSHBUTTON      "&Add output", IDC_ADD, 7, 212, 58, 14
    PUSHBUTTON      "Add a&ll SDI outputs", IDC_ADD_ALL, 69, 212, 80, 14
    PUSHBUTTON      "&Refresh lists", IDC_REFRESH, 153, 212, 60, 14
    LTEXT           "", IDC_COUNT_TEXT, 219, 215, 214, 8, SS_NOPREFIX
    LTEXT           "Display = capture a Windows screen (lowest delay). NDI = network source; type its exact name if it is offline.", IDC_SOURCE_HINT, 7, 231, 426, 8
    GROUPBOX        "Virtual monitors (Virtual Display Driver)", -1, 7, 244, 426, 34
    LTEXT           "Number of virtual monitors:", -1, 14, 259, 90, 8
    EDITTEXT        IDC_VMON_COUNT, 106, 257, 28, 12, ES_NUMBER
    CONTROL         "", IDC_VMON_SPIN, "msctls_updown32", UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 134, 257, 10, 12
    PUSHBUTTON      "A&pply...", IDC_VMON_APPLY, 148, 256, 46, 14
    LTEXT           "", IDC_VMON_INFO, 200, 255, 226, 18, SS_NOPREFIX
    LTEXT           "Output buffer:", -1, 7, 288, 60, 8
    COMBOBOX        IDC_BUFFER, 72, 286, 170, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Start output automatically when the app launches", IDC_AUTOSTART, 7, 306, 300, 10
    AUTOCHECKBOX    "Run at Windows startup", IDC_RUNATSTARTUP, 7, 320, 300, 10
    LTEXT           "Status:", -1, 7, 338, 30, 8
    LTEXT           "", IDC_STATUS, 40, 338, 393, 18, SS_NOPREFIX
    DEFPUSHBUTTON   "Save", IDOK, 327, 358, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 383, 358, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,3,0,0
 PRODUCTVERSION 1,3,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Screen2SDI - screen or NDI to DeckLink SDI output"
            VALUE "FileVersion", "1.3.0"
            VALUE "InternalName", "Screen2SDI"
            VALUE "OriginalFilename", "Screen2SDI.exe"
            VALUE "ProductName", "Screen2SDI"
            VALUE "ProductVersion", "1.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
